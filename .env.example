# Copy this file to .env and fill in your keys. Never commit .env.

# Required. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the model fallback list (comma separated, best first).
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b

# Optional: LangSmith tracing (free Developer plan, 5k traces/month).
# Key: https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pagepal
